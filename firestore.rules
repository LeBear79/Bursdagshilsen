rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function classIsMember(classId) {
      return signedIn()
        && userEmail() in get(/databases/$(database)/documents/classes/$(classId)).data.memberEmails;
    }

    function classIsOwner(classId) {
      return signedIn()
        && get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
    }

    match /classes/{classId} {
      allow read: if signedIn() && userEmail() in resource.data.memberEmails;

      // Bare Geir oppretter nye klasser i denne løsningen.
      allow create: if signedIn()
        && userEmail() == "geirbjornethun@gmail.com"
        && request.resource.data.ownerUid == request.auth.uid
        && userEmail() in request.resource.data.memberEmails;

      // Bare den som opprettet klassen kan endre delingen.
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && userEmail() in request.resource.data.memberEmails;

      allow delete: if false;

      match /birthdays/{birthdayId} {
        allow read, create, update, delete: if classIsMember(classId);
      }
    }

    match /pushTokens/{tokenId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail();

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail();

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /userSettings/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Gammel liste beholdes midlertidig slik at den kan importeres trygt til en klasse.
    match /birthdays/{birthdayId} {
      allow read: if signedIn() && userEmail() in [
        "geirbjornethun@gmail.com",
        "gulbrandsenmarte@gmail.com"
      ];
      allow write: if false;
    }
  }
}
